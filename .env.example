# LLM provider (OpenAI-compatible)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: use Anthropic instead
# ANTHROPIC_API_KEY=your-anthropic-key
# MODEL_PROVIDER=anthropic
# ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-latest

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Planning defaults
DEFAULT_SERVINGS=2
DEFAULT_WEEKLY_BUDGET=150.00
DEFAULT_CURRENCY=USD
MAX_MEALS_PER_DAY=4
ENABLE_BULK_OPTIMIZATION=true

# Observability
CREW_VERBOSE=true
CREW_MEMORY=false
